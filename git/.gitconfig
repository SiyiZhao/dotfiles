[pull]
	rebase = false

[core]
	quotepath = false

[include]
	path = ~/.gitconfig.local

[alias]
    overleaf-sync = "!f() { \
        if [ \"$(git branch --show-current)\" != main ]; then \
            echo 'Error: switch to main first'; \
            return 1; \
        fi; \
        git pull --rebase overleaf main && \
        git push overleaf main && \
        git push origin main; \
    }; f"
